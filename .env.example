# Copy to .env and fill in. Never commit .env — it is gitignored and
# dockerignored, and the values below are secrets.
#
#   cp .env.example .env

# --- Telegram -------------------------------------------------------------
# From @BotFather
BOT_TOKEN=
# Comma-separated Telegram user IDs with admin rights
ADMINS=

# Public URL Telegram posts updates to.
# TODO(stage-1): when the local Bot API server runs with --local it accepts an
# internal HTTP URL, which removes two hops through Cloudflare:
#   WEBHOOK_HOST=http://tg_bot:80/webhook
WEBHOOK_HOST=

# REQUIRED. Shared secret sent as X-Telegram-Bot-Api-Secret-Token and verified
# by SimpleRequestHandler. Without it anyone who learns the webhook URL can
# inject forged updates claiming to be any user id, including an admin.
# The bot refuses to start without it unless ALLOW_INSECURE_WEBHOOK=true.
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
WEBHOOK_SECRET=

# Escape hatch for local development only. When true, the bot starts with an
# unauthenticated webhook and logs a warning. Never set this in production.
ALLOW_INSECURE_WEBHOOK=

# Credentials for the self-hosted telegram-bot-api server (https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_LOCAL=1

# --- Postgres -------------------------------------------------------------
POSTGRES_DB=botbase
POSTGRES_USER=
POSTGRES_PASSWORD=
# Service name on the compose network
POSTGRES_HOST=postgres_db

# --- Redis ----------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
# REQUIRED. docker-compose passes this to `redis-server --requirepass`, so an
# empty value leaves Redis unauthenticated. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=

# --- External APIs --------------------------------------------------------
OPENROUTER_API_KEY=
RUNWARE_API_KEY=

# Sent to OpenRouter as HTTP-Referer / X-Title for attribution
SITE_URL=
SITE_NAME=AI Character Bot

# --- Branding (all optional) ----------------------------------------------
# Shown on the premium, stats and quota screens, e.g. @my_support
SUPPORT_CONTACT=
# Channel the user must join before creating a character. Empty disables the check.
CHANNEL_USERNAME=
# Defaults to https://t.me/<CHANNEL_USERNAME>
CHANNEL_LINK=
# User agreement pages. Empty hides the link button on the agreement screen.
AGREEMENT_URL_RU=
AGREEMENT_URL_EN=

# --- Models ---------------------------------------------------------------
# Every value below is optional; the defaults are what the bot shipped with.
# Model choice is the most direct cost-versus-quality lever here, so it is
# configuration, not code — a bad model can be rolled back without a rebuild.

# Character chat, via OpenRouter.
CHAT_MODEL=meta-llama/llama-3.3-70b-instruct
CHAT_TEMPERATURE=0.9
CHAT_MAX_TOKENS=1000
# Past turns replayed to the model. The database keeps 10 per profile; this is
# how many are actually sent. Raising it improves continuity and costs tokens.
MAX_HISTORY_LENGTH=5

# Turns a user's request into an image description, via OpenRouter.
PROMPT_MODEL=meta-llama/llama-3.3-70b-instruct
PROMPT_TEMPERATURE=0.7
PROMPT_MAX_TOKENS=300

# Image checkpoints, via Runware. Anything other than "realistic" uses anime.
IMAGE_MODEL_ANIME=runware:101@1
IMAGE_MODEL_REALISTIC=runware:101@1
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
IMAGE_STEPS=20
IMAGE_CFG_SCALE=7.5
RUNWARE_TIMEOUT=30

# --- Capacity -------------------------------------------------------------
# Postgres pool. The load test showed a registration wave (get-or-create is an
# INSERT, not a SELECT) saturating the pool at ~96 updates/s with the old
# hard-coded 10+10. Raise both together if /metrics shows db_pool_checked_out
# sitting near db_pool_size.
DB_POOL_SIZE=30
DB_MAX_OVERFLOW=20

# Per-downstream concurrency ceilings. Requests past these are shed with an
# honest "try again" rather than queued. See tgbot/services/limits.py.
LLM_CONCURRENCY=256
PROMPT_CONCURRENCY=64
IMAGE_CONCURRENCY=8
GLOBAL_INFLIGHT=1000

# Message quotas. Photo quotas live in tgbot/services/quotas.py.
FREE_MESSAGE_LIMIT=25
PREMIUM_MESSAGE_LIMIT=200

# --- Misc -----------------------------------------------------------------
# Parsed as a bool (true/1/yes vs false/0/empty). When true, only admins may
# use the bot.
IN_DEVELOPMENT=false
